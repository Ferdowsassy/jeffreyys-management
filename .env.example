# Public HTTPS origin with no trailing slash.
APP_ORIGIN=https://jeffreyys.example.com
# Host port used by Docker Compose. Put an HTTPS reverse proxy in front.
APP_PORT=3001
# Explicit trusted reverse-proxy address/subnet(s), comma-separated.
TRUST_PROXY=loopback
BOOTSTRAP_NAME=Owner
# Optional AI receipt/coach integration. Leave blank to disable explicitly.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Hostinger managed MySQL (backend only). No JSON file is used in this mode.
STORAGE_BACKEND=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Optional server override for the key entered by the chef under Einstellungen.
# Leave empty to use the key stored in the app.
GEOAPIFY_API_KEY=

# Optional: Google Places API (New), for receipt QR codes containing only a place ID.
GOOGLE_MAPS_SERVER_KEY=
