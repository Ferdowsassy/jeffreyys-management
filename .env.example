# Public HTTPS origin with no trailing slash.
APP_ORIGIN=https://jeffreyys.example.com
# Host port used by Docker Compose. Put an HTTPS reverse proxy in front.
APP_PORT=3001
# Explicit trusted reverse-proxy address/subnet(s), comma-separated.
TRUST_PROXY=loopback
BOOTSTRAP_NAME=Owner
# Optional AI receipt/coach integration. Leave blank to disable explicitly.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
