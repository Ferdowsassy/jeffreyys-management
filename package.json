{
  "name": "jeffreyys-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "hostinger.cjs",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node server/index.js",
    "start": "NODE_ENV=production node hostinger.cjs",
    "build": "vite build",
    "test": "node --test server/*.test.js src/*.test.js",
    "test:ui": "node scripts/ui-regressions.mjs all && node scripts/production-ui.mjs",
    "verify": "npm run build && npm test && npm run test:ui"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^7.0.0"
  }
}
