{
  "name": "jeffreyys-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "hostinger.cjs",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node server/index.js",
    "start": "NODE_ENV=production node hostinger.cjs",
    "build": "node scripts/prepare-ocr.mjs && vite build",
    "test": "node --test server/*.test.js src/*.test.js",
    "test:ui": "node scripts/ui-regressions.mjs all && node scripts/ocr-check.mjs && node scripts/production-ui.mjs && node scripts/features-ui.mjs && node scripts/location-ui.mjs && node scripts/pwa-check.mjs && node scripts/ux-improvements.mjs && node scripts/winorder-diagnostics-ui.mjs && node scripts/order-payments-ui.mjs",
    "verify": "npm run build && npm test && npm run test:ui"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "express": "^5.1.0",
    "fast-xml-parser": "5.11.2",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.5",
    "pdfkit": "^0.20.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^7.0.0",
    "vite": "^7.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
